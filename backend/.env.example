DATABASE_URL=postgres://postgres:postgres@localhost:5432/miniledger
JWT_SECRET=change-me
PORT=4000
UPLOAD_DIR=uploads
# Set to true when your Postgres host needs SSL (most hosted ones do)
DATABASE_SSL=false
# Set to true to show the OTP in the app (handy for a demo with no SMS)
SHOW_OTP_IN_RESPONSE=false
